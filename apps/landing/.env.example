# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Base de datos ────────────────────────────────────────────────────────────
# Driver de persistencia: "memory" (mock in-memory, por defecto) | "postgres"
DB_DRIVER=memory
# Solo para DB_DRIVER=postgres (Supabase self-hosted, cableado al final):
#   DATABASE_URL: pooler Supavisor + ?schema=<cliente> para multi-instancia
# DATABASE_URL=postgres://USER:PASSWORD@HOST:4000/postgres?pgbouncer=true&schema=cliente_demo
#   DIRECT_URL: conexión directa a Postgres (solo migraciones Prisma)
# DIRECT_URL=postgres://USER:PASSWORD@HOST:5432/postgres?schema=cliente_demo

# ─── A/B testing (Vercel Edge Config) ─────────────────────────────────────────
# Cadena de conexión de Edge Config (server-only, NUNCA NEXT_PUBLIC_).
# Si está ausente, el motor A/B cae a la cookie ab_variant.
# EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxx?token=xxx

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# En desarrollo, sin esta clave el correo de bienvenida se simula por consola.
# RESEND_API_KEY=re_xxx
# RESEND_FROM="Landing <hola@tudominio.com>"
